{
    "name": "Glossary Picker",
    "alias": "Stuff802.GlossaryPicker",
    "version": "1.0.0",
    "extensions": [
        {
            "type": "tiptapToolbarExtension",
            "kind": "button",
            "alias": "Stuff802.GlossaryPicker.ToolbarButton",
            "name": "Glossary Picker Toolbar Button",
            "js": "/App_Plugins/GlossaryPicker/dist/glossary-picker.js",
            "forExtensions": [],
            "meta": {
                "alias": "glossaryPicker",
                "icon": "icon-book-alt",
                "label": "Glossary Link"
            }
        },
        {
            "type": "modal",
            "alias": "Stuff802.Modal.GlossaryPicker",
            "name": "Glossary Picker Modal",
            "js": "/App_Plugins/GlossaryPicker/dist/glossary-picker.js",
            "element": "glossary-picker-modal"
        }
    ]
}
