          "segment": null,
          "value": "Figure 131"
        },
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Figure 131: Subordinate and well detailed extension, which reflects the architectural character of the original home in Harpenden"
