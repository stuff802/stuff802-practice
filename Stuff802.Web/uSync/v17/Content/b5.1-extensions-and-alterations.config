    <mainContent>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "d8ef038f-c2b4-45d1-95f2-6b4cd7b32d2a",
      "key": "b8329442-8363-464b-aee2-e9fcc1ac78c2",
      "udi": null,
      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EChanges to a home (such as extensions or loft conversions) can add valuable space and new life to a property. With careful attention to scale, proportion, and detail, these alterations can feel like a natural part of the original home. Thoughtful design helps ensure that any additions or changes sit comfortably within the wider streetscape, whilst respecting neighbours\u2019 outlook and privacy. By approaching extensions and alterations with care and consistency, we can support homes to grow and adapt, whilst keeping the character and harmony of the area intact.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "af26caf9-1a6b-40b3-9a94-8edf117bb7cd",
      "key": "3af70173-0e78-4a8e-a4ad-394d78f0d9b6",
