<Content Key="76788f64-e637-4d36-8bf3-d0306b899020" Alias="Guidance: G2.33" Level="6">
  <Info>
    <Parent Key="5c781178-c696-4e35-877a-dcf008c87a67">B2.7.1 Sensitively integrating photovoltaics (PV’s)</Parent>
    <Path>/HomePage/ChapterList/B2SustainableAndResilientPlaces/B27RenewableTechnologies/B271SensitivelyIntegratingPhotovoltaicsPVS/GuidanceG233</Path>
    <Trashed>false</Trashed>
    <ContentType>designCode</ContentType>
    <CreateDate>2025-09-10T17:15:01</CreateDate>
