  <Info>
    <Parent Key="4e9527f9-3c66-486a-9f12-caeb8906395f">B1.2.1 Working with the natural landscape</Parent>
    <Path>/HomePage/ChapterList/B1StrengtheningLocalCharacterAndContext/B12LandformAndTopography/B121WorkingWithTheNaturalLandscape/GuidanceG16</Path>
    <Trashed>false</Trashed>
    <ContentType>designCode</ContentType>
