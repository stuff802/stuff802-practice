    <Parent Key="df3434cb-70f4-4174-9366-bbd1c29852c1">B1.6.1 Reflecting local building traditions</Parent>
    <Path>/HomePage/ChapterList/B1StrengtheningLocalCharacterAndContext/B16StrengtheningLocalArchitecturalCharacter/B161ReflectingLocalBuildingTraditions/CodeC114</Path>
