    <Parent Key="94f893b9-b732-4145-8b3f-b2acde90d47a">B3.1.1 Creating inviting and accessible places</Parent>
    <Path>/HomePage/ChapterList/B3WelcomingPlaces/B31OpenSpacesAndCommunityFacilities/B311CreatingInvitingAndAccessiblePlaces/GuidanceG35</Path>
