    </codeType>
    <description>
      <Value><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "Layout": {}
  },
  "markup": "\u003Cp\u003EFor dormers proposed to the front or side elevations of a property that face the street they \u003Cstrong\u003Eshould:\u003C/strong\u003E\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u003Cp\u003Ealign vertically with the windows on the lower floors to maintain a consistent architectural rhythm\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ebe recessed from the main fa\u00E7ade of the building to appear visually subordinate\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ebe well set in from the roof edges, avoiding proximity to gable ends or party walls, to reduce visual dominance and preserve roof symmetry\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
}]]></Value>
    </description>
    <developmentScales>
      <Value><![CDATA[[
  "Householder Applications"
]]]></Value>
    </developmentScales>
