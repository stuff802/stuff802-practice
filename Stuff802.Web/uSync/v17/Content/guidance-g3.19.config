<Content Key="01594f02-50d8-4029-a991-1b08f7981167" Alias="Guidance: G3.19" Level="6">
  <Info>
    <Parent Key="a80f09fe-f5f0-44e5-96b1-d49cfdeb9fba">B3.6.1 Establishing a new character</Parent>
    <Path>/HomePage/ChapterList/B3WelcomingPlaces/B36CreatingANewIdentity/B361EstablishingANewCharacter/GuidanceG319</Path>
    <Trashed>false</Trashed>
    <ContentType>designCode</ContentType>
