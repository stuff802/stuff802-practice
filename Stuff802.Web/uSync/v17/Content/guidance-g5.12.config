<Content Key="1322c547-ed7d-4035-8f54-93e134f4579b" Alias="Guidance: G5.12" Level="6">
  <Info>
    <Parent Key="72fd6fb1-d2e9-4da7-a08d-ee73d44e0ce1">B5.1.5 Impact on neighbours and the streetscape</Parent>
    <Path>/HomePage/ChapterList/B5HealthyAndInclusiveHomes/B51ExtensionsAndAlterations/B515ImpactOnNeighboursAndTheStreetscape/GuidanceG512</Path>
    <Trashed>false</Trashed>
    <ContentType>designCode</ContentType>
