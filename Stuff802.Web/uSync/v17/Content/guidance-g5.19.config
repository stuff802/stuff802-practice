    </codeType>
    <description>
      <Value><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "Layout": {}
  },
  "markup": "\u003Cp\u003EFor buildings taller than three storeys, windows on upper floors \u003Cstrong\u003Eshould \u003C/strong\u003Ebe carefully positioned to protect the privacy of neighbouring properties. This includes minimising direct sightlines into nearby homes or other sensitive spaces. Additional design measures such as angled window placements, high-level or obscured glazing, and stepped or set-back facades \u003Cstrong\u003Eshould \u003C/strong\u003Ebe considered to reduce overlooking and maintain residential amenity.\u003C/p\u003E"
}]]></Value>
    </description>
    <developmentScales>
      <Value><![CDATA[[
  "Householder Applications",
  "Minor Residential Applications (1-9 homes)",
  "Major Residential Applications (10\u002B homes)",
  "Other Major Applications"
]]]></Value>
