    <Parent Key="c99aef5b-2e81-4a2e-938e-a11a2b2d14ae">B3.4.2 Addressing areas of open space</Parent>
    <Path>/HomePage/ChapterList/B3WelcomingPlaces/B34ActiveFrontages/B342AddressingAreasOfOpenSpace/CodeC323</Path>
