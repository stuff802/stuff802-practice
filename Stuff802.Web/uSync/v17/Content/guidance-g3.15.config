    <Parent Key="851a0d40-a07d-40f6-8215-9f2890cf0b3d">B3.3.1 Ensuring easy navigability</Parent>
    <Path>/HomePage/ChapterList/B3WelcomingPlaces/B33WayfindingAndLegibility/B331EnsuringEasyNavigability/GuidanceG315</Path>
