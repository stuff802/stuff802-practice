@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<DesignCodeList>
@{
    if (Model.Sections == null || Model.Sections.Count() == 0) return;
}
<div class="row gy-5 g-lg-5 mb-5">
    <div class="col-lg-12">
        <div class="admissions-requirements aos-init aos-animate" data-aos="fade-up">
            <div class="requirements-list mt-4">
                <div class="requirement-item aos-init aos-animate" data-aos="fade-up" data-aos-delay="100">
                    <div class="col-lg-12">
                        <h2>@Model.Title</h2>
                        @if (Model.Sections != null && Model.Sections.Any())
                        {
                            @Html.WMDCGetBlockListHtml(Model.Sections)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>