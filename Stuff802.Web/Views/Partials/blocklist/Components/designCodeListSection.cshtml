@inherits UmbracoViewPage<BlockListItem>
@inject IHttpContextAccessor _contextAccessor
@{
    var row = (DesignCodeListSection)Model.Content;
    var sectionTitle = row?.SectionTitle?.Trim() ?? string.Empty;
    var developmentScales = row?.DevelopmentScales ?? Array.Empty<string>();
    HttpContext? _context = _contextAccessor?.HttpContext ?? null;
    var scaleFilter = _context?.Session?.GetScaleFilter<string>("scaleFilter") ?? "";
    string parentBckColorScheme = ViewBag.BckColorScheme ?? "";
    string fontColor = ViewBag.FontColor ?? "";

    if (!developmentScales.Contains(scaleFilter, StringComparer.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(scaleFilter))
    {
        return;
    }    
}

<div class="requirement-item aos-init aos-animate design-code-list-section" data-aos="fade-up" data-aos-delay="100">
    <div class="col-lg-12">
        <div class="row d-flex pb-4">
            <div class="col-lg-7">
                <h5>@sectionTitle</h5>
            </div>
            <div class="col-lg-5">
                <div class="development-code-icon d-flex" role="group" aria-label="Applicable development scales and types">
                    @if(developmentScales.Any())
                    {
                        string[] scaleFilters = ["householder applications", "minor residential applications (1-9 homes)", "major residential applications (10+ homes)", "minor employment applications", "major employment applications", "other major applications"];

                        foreach (var code in scaleFilters)
                        {
                            if (developmentScales.Contains(code, StringComparer.OrdinalIgnoreCase))
                            {
                                switch (code.ToLower())
                                {
                                    case "householder applications":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-house-heart" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                    case "minor residential applications (1-9 homes)":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-house-add" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                    case "major residential applications (10+ homes)":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-houses-fill" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                    case "minor employment applications":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-building-fill" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                    case "major employment applications":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-buildings-fill" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                    case "other major applications":
                                        <div class="icon-box" style="background-color:@parentBckColorScheme;color:@fontColor">
                                            <i class="bi bi-card-list" role="img" title="@code" aria-label="@code"></i>
                                        </div>
                                        break;
                                }
                            }
                        }
                    }
                </div>
            </div>
        </div>
        <div class="row d-flex">
            @Html.WMDCGetBlockListHtml(row.SectionRows)
        </div>
    </div>
</div>